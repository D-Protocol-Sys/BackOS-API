generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String  @id @default(uuid())
  email     String  @unique
  firstName String
  lastName  String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  platformOwned Platform[]     @relation("PlatformOwner")
  generations   Generation[]

  @@map("users")
}


model OtpCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  attempts Int    @default(0)

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("otp_codes")
}


model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  level       Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}


model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}


model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}


enum PlatformStatus {
  DRAFT
  GENERATING
  ACTIVE
  ERROR
  ARCHIVED
}

model Platform {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  url         String?
  status      PlatformStatus @default(DRAFT)

  ownerId String
  owner   User   @relation("PlatformOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities    Entity[]
  generations Generation[]

  @@map("platforms")
}


model Entity {
  id         String @id @default(uuid())
  name       String
  tableName  String
  platformId String

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields Field[]

  @@unique([platformId, tableName])
  @@map("entities")
}


enum FieldType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
  FILE
  URL
  JSON
}


model Field {
  id       String    @id @default(uuid())
  name     String
  column   String
  type     FieldType
  required Boolean   
  unique   Boolean

  defaultValue String? 
  config       Json?

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, column])
  @@map("fields")
}


enum GenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Generation {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  status   GenerationStatus @default(PENDING)
  logs     String?
  errorMsg String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([platformId])
  @@map("generations")
}