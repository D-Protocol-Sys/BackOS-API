generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// ----------------------------------------------------------
// AUTH (OTP) / RBAC
// ----------------------------------------------------------

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  firstName String
  lastName  String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  platformOwned Platform[]     @relation("PlatformOwner")
  generations   Generation[]

  platformMemberships         PlatformMember[] @relation("PlatformMemberUser")
  platformRemovalRequestsMade PlatformMember[] @relation("PlatformMemberRemovalRequestedBy")

  @@map("users")
}

model OtpCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  attempts Int    @default(0)

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  level       Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------
// PLATFORMS
// ----------------------------------------------------------

enum PlatformStatus {
  DRAFT
  GENERATING
  ACTIVE
  ERROR
  ARCHIVED
}

enum PlatformRole {
  VIEWER
  EDITOR
  ADMIN
}

model PlatformDatabase {
  id         String   @id @default(uuid())
  platformId String   @unique
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  host              String
  port              Int
  databaseName      String
  databaseUser      String
  encryptedPassword String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_databases")
}

model Platform {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  url         String?
  status      PlatformStatus @default(DRAFT)

  ownerId String
  owner   User   @relation("PlatformOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  database    PlatformDatabase?
  
  entities    Entity[]
  generations Generation[]
  members     PlatformMember[]
  services    PlatformService[]
  relations   Relation[]

  @@index([ownerId])
  @@index([status])
  @@map("platforms")
}

model PlatformMember {
  id         String       @id @default(uuid())
  platformId String
  platform   Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation("PlatformMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role       PlatformRole

  removalRequestedAt   DateTime?
  removalRequestedById String?
  removalRequestedBy   User?     @relation("PlatformMemberRemovalRequestedBy", fields: [removalRequestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, userId])
  @@index([userId])
  @@map("platform_members")
}

model PlatformService {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  serviceKey String

  config          Json?
  encryptedConfig String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, serviceKey])
  @@map("platform_services")
}

// ----------------------------------------------------------
// ENTITIES / FIELDS
// ----------------------------------------------------------

model Entity {
  id         String  @id @default(uuid())
  name       String
  tableName  String
  platformId String
  isArchived Boolean @default(false)
  isSchedulable Boolean @default(false)

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields Field[]
  
  relationsAsA Relation[] @relation("RelationEntityA")
  relationsAsB Relation[] @relation("RelationEntityB")

  @@unique([platformId, tableName])
  @@index([platformId, isArchived])
  @@map("entities")
}

enum FieldType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
  FILE
  URL
  JSON
}

model Field {
  id       String    @id @default(uuid())
  name     String
  column   String
  type     FieldType
  required Boolean   @default(false)
  unique   Boolean   @default(false)

  defaultValue String?
  config       Json?
  isArchived   Boolean @default(false)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, column])
  @@index([entityId, isArchived])
  @@map("fields")
}

// ----------------------------------------------------------
// GENERATIONS
// ----------------------------------------------------------

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Generation {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  status   GenerationStatus @default(PENDING)
  logs     String?
  errorMsg String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([platformId])
  @@map("generations")
}

// ----------------------------------------------------------
// RELATIONS
// ----------------------------------------------------------

enum RelationType {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_MANY
}

model Relation {
  id         String       @id @default(uuid())
  platformId String
  platform   Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  type       RelationType

  entityAId String
  entityA   Entity @relation("RelationEntityA", fields: [entityAId], references: [id], onDelete: Cascade)
  entityBId String
  entityB   Entity @relation("RelationEntityB", fields: [entityBId], references: [id], onDelete: Cascade)

  fieldNameOnA String
  fieldNameOnB String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relations")
}