generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// ----------------------------------------------------------
// AUTH (Invitation + TOTP) / RBAC
// ----------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVATING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum StatusChangeReason {
  ONBOARDING
  VOLUNTARY_LEAVE
  TERMINATION
  LONG_LEAVE
  SECURITY_SUSPENSION
  PERIODIC_CLEANUP
  OTHER
}

model User {
  id String @id @default(uuid())

  workEmail     String @unique
  personalEmail String? @unique
  username      String @unique

  firstName String
  lastName  String

  status UserStatus @default(INVITED)

  lastLoginAt DateTime?
  lastSeenAt  DateTime?

  suspendedAt DateTime?
  disabledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UserProfile?
  mfa              UserMfa?
  recoveryCodes    RecoveryCode[]
  invitations      Invitation[]
  refreshTokens    RefreshToken[]
  userRoles        UserRole[]
  platformOwned    Platform[] @relation("PlatformOwner")
  generations      Generation[]
  auditLogs        AuditLog[] @relation("AuditActor")

  statusHistory               UserStatusHistory[]   @relation("UserStatusHistorySubject")
  performedStatusChanges      UserStatusHistory[]   @relation("UserStatusHistoryPerformedBy")
  platformMemberships         PlatformMember[]      @relation("PlatformMemberUser")
  platformRemovalRequestsMade PlatformMember[]      @relation("PlatformMemberRemovalRequestedBy")

  @@index([status])
  @@index([username])
  @@index([workEmail])

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  phone           String?
  phoneVerifiedAt DateTime?
  dateOfBirth     DateTime?
  location        String?
  country         String?
  company         String?
  jobTitle        String?
  websiteUrl      String?
  avatarUrl       String?
  language        String? @default("fr")
  timezone        String?

  socialLinks Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model UserStatusHistory {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation("UserStatusHistorySubject", fields: [userId], references: [id], onDelete: Cascade)

  previousStatus UserStatus?
  newStatus      UserStatus

  reason         StatusChangeReason

  comment        String?

  performedById  String?
  performedBy    User?      @relation("UserStatusHistoryPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([performedById])

  @@map("user_status_history")
}

model Invitation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  codeHash  String
  attempts  Int    @default(0)

  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("invitations")
}

enum MfaStatus {
  PENDING
  ACTIVE
  REVOKED
}

model UserMfa {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secretEncrypted String
  status          MfaStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_mfa")
}

model RecoveryCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id      String  @id @default(uuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action String

  targetType  String?
  targetId    String?

  metadata Json?

  ipAddress String?
  userAgent String?

  requestId String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])

  @@map("audit_logs")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  level       Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------
// PLATFORMS
// ----------------------------------------------------------

enum PlatformStatus {
  DRAFT
  GENERATING
  ACTIVE
  ERROR
  ARCHIVED
}

enum PlatformRole {
  VIEWER
  EDITOR
  ADMIN
}

model PlatformDatabase {
  id         String   @id @default(uuid())
  platformId String   @unique
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  host              String
  port              Int
  databaseName      String
  databaseUser      String
  encryptedPassword String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_databases")
}

model Platform {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  url         String?
  status      PlatformStatus @default(DRAFT)

  generatedPort Int?

  ownerId String
  owner   User   @relation("PlatformOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  database    PlatformDatabase?
  
  entities    Entity[]
  generations Generation[]
  members     PlatformMember[]
  services    PlatformService[]
  relations   Relation[]

  @@index([ownerId])
  @@index([status])
  @@map("platforms")
}

model PlatformMember {
  id         String       @id @default(uuid())
  platformId String
  platform   Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation("PlatformMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role       PlatformRole

  removalRequestedAt   DateTime?
  removalRequestedById String?
  removalRequestedBy   User?     @relation("PlatformMemberRemovalRequestedBy", fields: [removalRequestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, userId])
  @@index([userId])
  @@map("platform_members")
}

model PlatformService {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  serviceKey String

  config          Json?
  encryptedConfig String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, serviceKey])
  @@map("platform_services")
}

// ----------------------------------------------------------
// ENTITIES / FIELDS
// ----------------------------------------------------------

model Entity {
  id         String  @id @default(uuid())
  name       String
  tableName  String
  platformId String
  isArchived Boolean @default(false)
  isSchedulable Boolean @default(false)

  authProtectCreate Boolean @default(false)
  authProtectRead   Boolean @default(false)
  authProtectUpdate Boolean @default(false)
  authProtectDelete Boolean @default(false)

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields Field[]
  
  relationsAsA Relation[] @relation("RelationEntityA")
  relationsAsB Relation[] @relation("RelationEntityB")

  @@unique([platformId, tableName])
  @@index([platformId, isArchived])
  @@map("entities")
}

enum FieldType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
  FILE
  URL
  JSON
}

model Field {
  id       String    @id @default(uuid())
  name     String
  column   String
  type     FieldType
  required Boolean   @default(false)
  unique   Boolean   @default(false)

  defaultValue String?
  config       Json?
  isArchived   Boolean @default(false)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, column])
  @@index([entityId, isArchived])
  @@map("fields")
}

// ----------------------------------------------------------
// GENERATIONS
// ----------------------------------------------------------

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Generation {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  status   GenerationStatus @default(PENDING)
  logs     String?
  errorMsg String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([platformId])
  @@map("generations")
}

// ----------------------------------------------------------
// RELATIONS
// ----------------------------------------------------------

enum RelationType {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_MANY
}

model Relation {
  id         String       @id @default(uuid())
  platformId String
  platform   Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  type       RelationType

  entityAId String
  entityA   Entity @relation("RelationEntityA", fields: [entityAId], references: [id], onDelete: Cascade)
  entityBId String
  entityB   Entity @relation("RelationEntityB", fields: [entityBId], references: [id], onDelete: Cascade)

  fieldNameOnA String
  fieldNameOnB String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relations")
}