# Copy to deploy/.env.production and fill in real values. Never commit the real file.
# Values consumed directly by docker-compose.prod.yml (Postgres/Redis credentials, domain,
# paths) live here as plain Compose variables. Everything else the orchestrator itself needs
# (JWT_SECRET, SMTP_*, ENCRYPTION_KEY, ...) is read from this SAME file via `env_file:` in
# docker-compose.prod.yml, validated at boot by src/config/env.validation.ts.

# --- Compose-level / infra ---
ACME_EMAIL=ops@example.com
PUBLIC_DOMAIN=backos.example.com
POSTGRES_USER=backos
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=backos
# Same provisioner role used in dev's docker-compose.yml - created by docker/postgres-init on
# Postgres's first boot. Must also match POSTGRES_PROVISIONING_ROLE below.
POSTGRES_PROVISIONING_ROLE=backos_provisioner
POSTGRES_PROVISIONING_PASSWORD=change-me-generate-a-real-secret
REDIS_PASSWORD=change-me-generate-a-real-secret
# Absolute path on the DOCKER HOST (not inside any container) where generated projects live -
# see docker-compose.prod.yml's comment on the DooD identity bind mount. Must already exist and
# be writable by whatever UID the orchestrator container runs as.
GENERATED_PROJECTS_HOST_PATH=/opt/backos/generated

# --- Orchestrator application config (src/config/env.validation.ts) ---
SERVER_NAME=backos-prod
NODE_ENV=production
PORT=4803
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com

# DATABASE_URL / POSTGRES_PROVISIONING_URL / PROVISION_HOST / REDIS_HOST / REDIS_PORT are set
# directly in docker-compose.prod.yml's `orchestrator.environment` block (derived from
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above) - do not duplicate them here.
POSTGRES_SHADOW_DATABASE_NAME=backos_migration_shadow

ENCRYPTION_KEY=replace-with-64-hex-chars-256-bit-key
BCRYPT_SALT_ROUNDS=12

JWT_SECRET=replace-with-a-real-32-plus-char-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

OTP_EXPIRES_IN_MINUTES=10
INVITATION_MAX_ATTEMPTS=5
INVITATION_EXPIRES_IN_HOURS=48

OTP_CLEANUP_RETENTION_DAYS=7
REFRESH_TOKEN_CLEANUP_RETENTION_DAYS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="BackOS <no-reply@example.com>"

LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

GENERATION_COMMAND_TIMEOUT_MS=300000
GENERATION_PORT_RANGE_START=4100
GENERATION_PORT_RANGE_END=4999

GENERATED_BACKEND_HOST=127.0.0.1
GENERATED_BACKEND_GATEWAY_PREFIX=/generated
GENERATED_BACKEND_MEMORY_LIMIT=256m
GENERATED_BACKEND_CPU_LIMIT=0.5
# See env.validation.ts - prefix for each platform's own dedicated Docker network.
GENERATED_BACKEND_DOCKER_NETWORK=backos-gen-net

BACKUP_OUTPUT_DIR=backups
BACKUP_TIMEOUT_MS=600000

OWNER_WORKEMAIL=owner@example.com
OWNER_PERSONALEMAIL=owner-personal@example.com
OWNER_FIRSTNAME=Owner
OWNER_LASTNAME=Name
OWNER_USERNAME=owner

# --- Optional: read-only demo/sandbox account (see prisma/seed-demo.ts, run manually - not
# part of the automatic `prisma db seed`). Leave unset if you don't want a demo account. ---
# DEMO_WORKEMAIL=demo@example.com
# DEMO_USERNAME=demo
# DEMO_FIRSTNAME=Demo
# DEMO_LASTNAME=Account
# DEMO_TOTP_SECRET=generate-one-base32-secret-once-and-keep-it-stable
