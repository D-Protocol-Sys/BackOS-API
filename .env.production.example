# ==============================================================================
# ENV TEMPLATE: PUBLIC PRODUCTION (real domain, HTTPS, Traefik)
# ------------------------------------------------------------------------------
# EN: Copy to ".env.production" at the repo root, next to docker-compose.yml.
#     Used for BOTH the ${...} substitution in deploy/docker-compose.prod.yml
#     AND as the container's env_file - one single source of truth for prod.
#     This is for a backend exposed PUBLICLY on the internet with a real
#     domain name and automatic HTTPS certificates (Traefik + Let's Encrypt).
#     NOT what you want for a private, home-network-only deployment - use
#     ".env.lan.example" instead for that case.
#     NEVER commit the filled-in ".env.production" - only this .example.
# FR: Copie vers ".env.production" à la racine, à côté de docker-compose.yml.
#     Utilisé à la fois pour la substitution ${...} dans
#     deploy/docker-compose.prod.yml ET comme env_file du conteneur -
#     une seule source de vérité pour la prod.
#     C'est pour un backend exposé PUBLIQUEMENT sur internet avec un vrai nom
#     de domaine et des certificats HTTPS automatiques (Traefik + Let's
#     Encrypt). Ce n'est PAS ce qu'il te faut pour un déploiement privé sur
#     ton réseau local - utilise ".env.lan.example" pour ce cas-là.
#     NE JAMAIS committer le ".env.production" rempli - seul ce .example.
# ==============================================================================

# ==> Renaming the project everywhere happens ONLY here.
PROJECT_NAME=myproject
SERVER_NAME=${PROJECT_NAME}-prod
SERVER_URL=myserver-url

NODE_ENV=production
PORT=4803
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com

# --- Edge / Traefik (see deploy/docker-compose.edge.yml) ---
ACME_EMAIL=admin@example.com
PROD_DOMAIN=api.example.com

# --- Database / Redis ---
POSTGRES_USER=monprojet_prod
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=monprojet_prod
POSTGRES_PROVISIONING_ROLE=monprojet_provisioner
POSTGRES_PROVISIONING_PASSWORD=change-me-strong-random
REDIS_PASSWORD=change-me-strong-random

# --- Security / encryption ---
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# --- SMTP (real transactional email provider) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM="Myproject <no-reply@example.com>"

# --- Owner account - auto-created on first startup (deploy/entrypoint.sh) ---
OWNER_WORKEMAIL=REPLACE_ME@example.com
OWNER_PERSONALEMAIL=REPLACE_ME@example.com
OWNER_FIRSTNAME=REPLACE_ME
OWNER_LASTNAME=REPLACE_ME
OWNER_USERNAME=REPLACE_ME

# --- Platform generation (DooD - see docker-compose.prod.yml) ---
# EN: Path must be IDENTICAL on the host and inside the container - mandatory,
#     see the comment in docker-compose.prod.yml about the "identity" bind mount.
# FR: Chemin IDENTIQUE sur l'hôte et dans le conteneur - impératif, voir le
#     commentaire dans docker-compose.prod.yml sur le montage bind "identité".
GENERATED_PROJECTS_HOST_PATH=/srv/myprojet/generated-prod

# --- Image ---
IMAGE_TAG=latest
