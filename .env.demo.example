# Copier vers ".env.demo" (racine du repo). Environnement de PRESENTATION/DEMONSTRATION -
# même image Docker que la prod, données et domaine totalement séparés (voir
# deploy/docker-compose.demo.yml et README_DEPLOIEMENT.md).
#
# NE JAMAIS committer ce fichier une fois rempli (voir .gitignore) - seul ce .example l'est.

# ==> Renommer le projet partout se fait UNIQUEMENT ici.
PROJECT_NAME=monprojet
SERVER_NAME=${PROJECT_NAME}-demo

NODE_ENV=production
PORT=4803
CORS_ORIGIN=https://demo.example.com
FRONTEND_URL=https://demo.example.com

# --- Edge / Traefik (voir deploy/docker-compose.edge.yml) ---
ACME_EMAIL=admin@example.com
DEMO_DOMAIN=demo.example.com

# --- Base de données / Redis ---
POSTGRES_USER=monprojet_demo
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=monprojet_demo
POSTGRES_PROVISIONING_ROLE=monprojet_provisioner
POSTGRES_PROVISIONING_PASSWORD=change-me-strong-random
REDIS_PASSWORD=change-me-strong-random

# --- Sécurité / chiffrement ---
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# --- SMTP (fournisseur transactionnel réel) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM="Monprojet <no-reply@example.com>"

# --- Compte owner - créé automatiquement au premier démarrage (deploy/entrypoint.sh) ---
OWNER_WORKEMAIL=REPLACE_ME@example.com
OWNER_PERSONALEMAIL=REPLACE_ME@example.com
OWNER_FIRSTNAME=REPLACE_ME
OWNER_LASTNAME=REPLACE_ME
OWNER_USERNAME=REPLACE_ME

# --- Génération de plateformes (DooD - voir docker-compose.prod.yml) ---
# Chemin IDENTIQUE sur l'hôte et dans le conteneur - impératif, voir le commentaire dans
# docker-compose.prod.yml sur le montage bind "identité".
GENERATED_PROJECTS_HOST_PATH=/srv/monprojet/generated-demo

# --- Compte de démonstration PUBLIC, lecture seule (RUN_DEMO_SEED=1, voir
# deploy/docker-compose.demo.yml et prisma/seed-demo.ts). Peut être publié sans risque : le
# rôle "demo" ne permet ni créer, ni modifier, ni supprimer quoi que ce soit.
DEMO_WORKEMAIL=demo@example.com
DEMO_USERNAME=demo
DEMO_FIRSTNAME=Demo
DEMO_LASTNAME=Account
# Secret TOTP volontairement PARTAGE publiquement (page de démo, QR code, README) - voir la
# note de conception dans prisma/seed-demo.ts. Générer une fois avec un outil TOTP quelconque.
DEMO_TOTP_SECRET=REPLACE_WITH_A_FIXED_BASE32_TOTP_SECRET

# --- Image ---
IMAGE_TAG=latest
