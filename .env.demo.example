# ==============================================================================
# ENV TEMPLATE: PUBLIC DEMO / SHOWCASE
# ------------------------------------------------------------------------------
# EN: Copy to ".env.demo" at the repo root. Same Docker image as production,
#     but fully separate domain and data (see deploy/docker-compose.demo.yml
#     and README_DEPLOIEMENT.md). Used to give strangers a safe, read-only
#     account to try the product without touching real/prod data.
#     NEVER commit the filled-in ".env.demo" - only this .example.
# FR: Copie vers ".env.demo" à la racine. Même image Docker que la prod,
#     mais données et domaine totalement séparés (voir
#     deploy/docker-compose.demo.yml et README_DEPLOIEMENT.md). Sert à donner
#     à des inconnus un compte de démo en lecture seule, sans toucher aux
#     vraies données de prod.
#     NE JAMAIS committer le ".env.demo" rempli - seul ce .example.
# ==============================================================================

# ==> Renaming the project everywhere happens ONLY here.
PROJECT_NAME=myproject
SERVER_NAME=${PROJECT_NAME}-demo
SERVER_URL=myserver-url

NODE_ENV=production
PORT=4803
CORS_ORIGIN=https://demo.example.com
FRONTEND_URL=https://demo.example.com

# --- Edge / Traefik (see deploy/docker-compose.edge.yml) ---
ACME_EMAIL=admin@example.com
DEMO_DOMAIN=demo.example.com

# --- Database / Redis ---
POSTGRES_USER=myproject_demo
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=myproject_demo
POSTGRES_PROVISIONING_ROLE=myproject_provisioner
POSTGRES_PROVISIONING_PASSWORD=change-me-strong-random
REDIS_PASSWORD=change-me-strong-random

# --- Security / encryption ---
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# --- SMTP (real transactional email provider) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM="Myproject <no-reply@example.com>"

# --- Owner account - auto-created on first startup (deploy/entrypoint.sh) ---
OWNER_WORKEMAIL=REPLACE_ME@example.com
OWNER_PERSONALEMAIL=REPLACE_ME@example.com
OWNER_FIRSTNAME=REPLACE_ME
OWNER_LASTNAME=REPLACE_ME
OWNER_USERNAME=REPLACE_ME

# --- Platform generation (DooD - see docker-compose.prod.yml) ---
GENERATED_PROJECTS_HOST_PATH=/srv/myproject/generated-demo

# --- Public demo account, read-only (RUN_DEMO_SEED=1, see
#     deploy/docker-compose.demo.yml and prisma/seed-demo.ts). Safe to
#     publish: the "demo" role cannot create, edit, or delete anything. ---
DEMO_WORKEMAIL=demo@example.com
DEMO_USERNAME=demo
DEMO_FIRSTNAME=Demo
DEMO_LASTNAME=Account
# EN: This TOTP secret is intentionally shared PUBLICLY (demo page, QR code,
#     README) - see the design note in prisma/seed-demo.ts. Generate once with
#     any TOTP tool.
# FR: Ce secret TOTP est volontairement partagé PUBLIQUEMENT (page de démo, QR
#     code, README) - voir la note de conception dans prisma/seed-demo.ts.
#     Génère-le une fois avec n'importe quel outil TOTP.
DEMO_TOTP_SECRET=REPLACE_WITH_A_FIXED_BASE32_TOTP_SECRET

# --- Image ---
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# ADDED BY THE AUDIT CORRECTION PASS (see CORRECTIONS.md)
# ------------------------------------------------------------------------------
# Non-superuser role the application connects with (created by
# docker/postgres-init/02-app-role.sh). DATABASE_URL must use it; the provisioning URL must use
# POSTGRES_PROVISIONING_ROLE / POSTGRES_PROVISIONING_PASSWORD (never the superuser).
POSTGRES_APP_USER=myproject_runtime
# REPLACE_ME - generate with: openssl rand -hex 24
POSTGRES_APP_PASSWORD=REPLACE_ME
# Redis ACL user / TLS (optional). REDIS_PASSWORD is mandatory in production (min 16 chars).
# REDIS_USERNAME=
# REDIS_TLS=false
# Reverse-proxy hops to trust for the client IP (0 = none, 1 = behind Traefik).
TRUST_PROXY_HOPS=1
# Uploads directory (mounted volume in Docker) and per-user quota.
UPLOAD_DIR=/app/uploads
USER_UPLOAD_QUOTA_MB=1024
# Days before a deactivated account is anonymized.
DEACTIVATION_GRACE_PERIOD_DAYS=30
# Prisma connection-pool size per instance.
DATABASE_POOL_MAX=10
# Max automatic restarts of a generated backend container.
GENERATION_MAX_AUTO_RESTARTS=5
# Redis made available to generated backends that enable the scheduler service (each platform
# gets its own key prefix). Leave empty to reuse REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
# GENERATED_BACKEND_REDIS_HOST=
# GENERATED_BACKEND_REDIS_PORT=
# GENERATED_BACKEND_REDIS_PASSWORD=
# SMTP: STARTTLS is required by default; set to false only for a local test SMTP server.
SMTP_REQUIRE_TLS=true
# Structured JSON logs (json) or human-readable (text).
LOG_FORMAT=json
# In production the seed writes the owner activation link to this 0600 file instead of stdout.
SEED_ACTIVATION_FILE=owner-activation.txt

# --- OPTIONAL FEATURES ---
# Comma-separated list of the optional features to switch on. Empty or unset = the base BackOS.
# `all` switches every installed feature on, `-name` switches one off. A name that is not
# installed stops BackOS at startup with a clear message. See docs/FEATURES.md.
# ENABLED_FEATURES=
