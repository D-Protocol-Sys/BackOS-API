# ==============================================================================
# ENV TEMPLATE: LAN DEPLOYMENT (local network only, no public exposure)
# ------------------------------------------------------------------------------
# EN: Copy this file to ".env.lan" at the project root, then fill in every
#     value marked REPLACE_ME. ".env.lan" (without ".example") is the REAL
#     file with your actual secrets - it is git-ignored and must NEVER be
#     committed or pushed to GitHub. Only THIS ".example" file belongs in git.
#     Used by: deploy/docker-compose.lan.yml (see "env_file: ../.env.lan").
#     Purpose: run the backend on your own PC (PC1), reachable only from
#     devices on your home network (e.g. PC2) - no domain name, no Traefik,
#     no HTTPS certificate, no public internet exposure.
# FR: Copie ce fichier vers ".env.lan" à la racine du projet, puis remplis
#     chaque valeur marquée REPLACE_ME. ".env.lan" (sans ".example") est le
#     VRAI fichier avec tes secrets - il est ignoré par git et ne doit JAMAIS
#     être commité ni poussé sur GitHub. Seul CE fichier ".example" va sur git.
# ==============================================================================

PROJECT_NAME=myproject
SERVER_URL=myserver-url

# --- APPLICATION ---
SERVER_NAME=${PROJECT_NAME}-lan
NODE_ENV=production
PORT=4803

# EN: "*" allows any origin to call the API. Safe here ONLY because the server
#     is never reachable from outside your home network. Restrict this to the
#     exact frontend origin later if you tighten security.
# FR: "*" autorise n'importe quelle origine à appeler l'API. Sans risque ici
#     UNIQUEMENT parce que le serveur n'est jamais joignable depuis l'extérieur
#     de ton réseau local. Restreins-le à l'origine exacte du frontend plus tard.
CORS_ORIGIN=*

# EN: The address your frontend (running on PC2) will use to reach this
#     backend. Use PC1's fixed LAN IP (see the DHCP static lease guide).
# FR: L'adresse que ton frontend (sur PC2) utilisera pour joindre ce backend.
#     Utilise l'IP LAN fixe de PC1 (voir le guide de bail DHCP statique).
FRONTEND_URL=http://REPLACE_ME_IP_PC1:4803

# --- DATABASE (PostgreSQL) ---
# EN: Generate strong random values with: openssl rand -hex 16
# FR: Génère des valeurs aléatoires solides avec : openssl rand -hex 16
POSTGRES_USER=myproject_app
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_16
POSTGRES_DB=myproject_db
POSTGRES_PROVISIONING_ROLE=myproject_provisioning
POSTGRES_PROVISIONING_PASSWORD=REPLACE_WITH_openssl_rand_hex_16

# --- REDIS ---
REDIS_PASSWORD=REPLACE_WITH_openssl_rand_hex_16

# --- SECURITY / ENCRYPTION ---
# EN: These two are cryptographic secrets, not passwords - never reuse the
#     ones from another environment (dev/test/prod). Generate fresh ones:
#       ENCRYPTION_KEY : openssl rand -hex 32
#       JWT_SECRET     : openssl rand -base64 48
# FR: Ce sont des clés cryptographiques, pas des mots de passe - ne réutilise
#     jamais celles d'un autre environnement (dev/test/prod). Génère-en de
#     nouvelles avec les commandes ci-dessus.
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48

# --- SMTP (account activation emails, login codes) ---
# EN: See the deployment guide for how to create a Gmail "App Password"
#     (myaccount.google.com/apppasswords). Do NOT use your real Gmail password.
# FR: Voir le guide de déploiement pour créer un "mot de passe d'application"
#     Gmail (myaccount.google.com/apppasswords). N'utilise pas ton vrai
#     mot de passe Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_ton.email@gmail.com
SMTP_PASSWORD=REPLACE_ME_mot_de_passe_application_16_caracteres
SMTP_FROM=REPLACE_ME_ton.email@gmail.com

# --- OWNER ACCOUNT (auto-created on first startup by deploy/entrypoint.sh) ---
OWNER_WORKEMAIL=REPLACE_ME.email@gmail.com
OWNER_PERSONALEMAIL=REPLACE_ME.email@gmail.com
OWNER_FIRSTNAME=REPLACE_ME_FIRSTNAME
OWNER_LASTNAME=REPLACE_ME_LASTNAME
OWNER_USERNAME=REPLACE_ME_USERNAME

# ------------------------------------------------------------------------------
# ADDED BY THE AUDIT CORRECTION PASS (see CORRECTIONS.md)
# ------------------------------------------------------------------------------
# Non-superuser role the application connects with (created by
# docker/postgres-init/02-app-role.sh). DATABASE_URL must use it; the provisioning URL must use
# POSTGRES_PROVISIONING_ROLE / POSTGRES_PROVISIONING_PASSWORD (never the superuser).
POSTGRES_APP_USER=myproject_runtime
# REPLACE_ME - generate with: openssl rand -hex 24
POSTGRES_APP_PASSWORD=REPLACE_ME
# Redis ACL user / TLS (optional). REDIS_PASSWORD is mandatory in production (min 16 chars).
# REDIS_USERNAME=
# REDIS_TLS=false
# Reverse-proxy hops to trust for the client IP (0 = none, 1 = behind Traefik).
TRUST_PROXY_HOPS=0
# Uploads directory (mounted volume in Docker) and per-user quota.
UPLOAD_DIR=/app/uploads
USER_UPLOAD_QUOTA_MB=1024
# Days before a deactivated account is anonymized.
DEACTIVATION_GRACE_PERIOD_DAYS=30
# Prisma connection-pool size per instance.
DATABASE_POOL_MAX=10
# Max automatic restarts of a generated backend container.
GENERATION_MAX_AUTO_RESTARTS=5
# Redis made available to generated backends that enable the scheduler service (each platform
# gets its own key prefix). Leave empty to reuse REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
# GENERATED_BACKEND_REDIS_HOST=
# GENERATED_BACKEND_REDIS_PORT=
# GENERATED_BACKEND_REDIS_PASSWORD=
# SMTP: STARTTLS is required by default; set to false only for a local test SMTP server.
SMTP_REQUIRE_TLS=true
# Structured JSON logs (json) or human-readable (text).
LOG_FORMAT=json
# In production the seed writes the owner activation link to this 0600 file instead of stdout.
SEED_ACTIVATION_FILE=owner-activation.txt
