# Copier vers ".env.test" (racine du repo). Chargé par test/env-e2e.ts et par
# test/global-setup-e2e.ts. Sert UNIQUEMENT aux tests e2e automatisés (pnpm test:e2e) -
# différent de l'environnement "demo" (voir .env.demo.example / README_DEPLOIEMENT.md).

PROJECT_NAME=monprojet
SERVER_NAME=${PROJECT_NAME}-test
NODE_ENV=test
PORT=4813

POSTGRES_USER=monprojet_test
POSTGRES_PASSWORD=monprojet_test
POSTGRES_DB=monprojet_test
POSTGRES_PROVISIONING_ROLE=monprojet_provisioner_test
POSTGRES_PROVISIONING_PASSWORD=monprojet_provisioner_test
POSTGRES_TEST_PORT=5433
REDIS_TEST_PORT=6380
DATABASE_URL=postgresql://monprojet_test:monprojet_test@127.0.0.1:5433/monprojet_test?schema=public
POSTGRES_PROVISIONING_URL=postgresql://monprojet_test:monprojet_test@127.0.0.1:5433/postgres
PROVISION_HOST=127.0.0.1
PROVISION_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
JWT_SECRET=test-jwt-secret-min-32-characters-long
BCRYPT_SALT_ROUNDS=4

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM="Test <test@localhost>"

OWNER_WORKEMAIL=owner@e2e.test
OWNER_PERSONALEMAIL=owner-perso@e2e.test
OWNER_FIRSTNAME=E2E
OWNER_LASTNAME=Owner
OWNER_USERNAME=e2e-owner

GENERATED_PROJECTS_ROOT=./generated-test
