# ==============================================================================
# ENV TEMPLATE: AUTOMATED E2E TESTS
# ------------------------------------------------------------------------------
# EN: Copy to ".env.test" at the repo root. Loaded by test/env-e2e.ts and
#     test/global-setup-e2e.ts. Used ONLY by automated e2e tests
#     (pnpm test:e2e) - different from the "demo" environment
#     (see .env.demo.example / README_DEPLOIEMENT.md).
#     Low risk if leaked (throwaway local test DB, BCRYPT_SALT_ROUNDS=4 for
#     speed), but still git-ignored by convention/consistency - keep secrets
#     out of git as a habit, even low-stakes ones.
# FR: Copie vers ".env.test" à la racine. Chargé par test/env-e2e.ts et
#     test/global-setup-e2e.ts. Sert UNIQUEMENT aux tests e2e automatisés
#     (pnpm test:e2e) - différent de l'environnement "demo"
#     (voir .env.demo.example / README_DEPLOIEMENT.md).
#     Peu risqué en cas de fuite (base de test jetable en local,
#     BCRYPT_SALT_ROUNDS=4 pour la vitesse), mais quand même ignoré par git
#     par convention/cohérence - garder les secrets hors de git par habitude,
#     même les peu sensibles.
# ==============================================================================

PROJECT_NAME=myproject
SERVER_NAME=${PROJECT_NAME}-test
NODE_ENV=test
PORT=4813

POSTGRES_USER=myproject_test
POSTGRES_PASSWORD=myproject_test
POSTGRES_DB=myproject_test
POSTGRES_PROVISIONING_ROLE=myproject_provisioner_test
POSTGRES_PROVISIONING_PASSWORD=myproject_provisioner_test
POSTGRES_TEST_PORT=5433
REDIS_TEST_PORT=6380
DATABASE_URL=postgresql://myproject_test:myproject_test@127.0.0.1:5433/myproject_test?schema=public
POSTGRES_PROVISIONING_URL=postgresql://myproject_test:myproject_test@127.0.0.1:5433/postgres
PROVISION_HOST=127.0.0.1
PROVISION_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
JWT_SECRET=test-jwt-secret-min-32-characters-long
BCRYPT_SALT_ROUNDS=4

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM="Test <test@localhost>"

OWNER_WORKEMAIL=owner@e2e.test
OWNER_PERSONALEMAIL=owner-perso@e2e.test
OWNER_FIRSTNAME=E2E
OWNER_LASTNAME=Owner
OWNER_USERNAME=e2e-owner

GENERATED_PROJECTS_ROOT=./generated-test
