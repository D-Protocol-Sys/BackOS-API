# ==============================================================================
# .env.local - "local" stack (deploy/docker-compose.local.yml)
# ==============================================================================
# Copy this file to `.env.local` (same folder, repo root) and fill in every
# REPLACE_ME value before running `./scripts/stack.sh up local`.
#
# This file is consumed BOTH by docker-compose.local.yml itself (PROJECT_NAME,
# POSTGRES_*, REDIS_PASSWORD, LOCAL_PORT, GENERATED_PROJECTS_HOST_PATH, IMAGE_TAG)
# AND passed through into the orchestrator container as its application config
# (everything else - cross-checked against src/config/env.validation.ts, which is
# the authoritative list the app validates at boot).
#
# NEVER commit the real `.env.local` file - only this .example is tracked in git.
# ==============================================================================

# ------------------------------------------------------------------------------
# PROJECT IDENTITY (docker-compose only - container/network/volume naming)
# ------------------------------------------------------------------------------
PROJECT_NAME=myproject
SERVER_NAME=${PROJECT_NAME}-Local
SERVER_URL=myserver-url

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4803
# Port exposed on the HOST machine (docker-compose.local.yml only) - what you put
# after "localhost:" in your browser. Change this if 4803 is already taken on
# your machine; the app inside the container always listens on 4803 regardless.
LOCAL_PORT=4803
# No public domain, so no CORS restriction needed for a single-machine/LAN setup.
# Tighten this (e.g. to your frontend's exact origin) if that ever changes.
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# POSTGRES
# ------------------------------------------------------------------------------
POSTGRES_USER=${PROJECT_NAME}_app
# REPLACE_ME - generate with: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=myproject_db
POSTGRES_PROVISIONING_ROLE=myproject_provisioning
PROVISION_HOST=postgres
PROVISION_PORT=5432
POSTGRES_SHADOW_DATABASE_NAME=myproject_migration_shadow

# Built from the values above - keep these three in sync if you change them.
DATABASE_URL=postgresql://myproject_app:REPLACE_ME@postgres:5432/myproject?schema=public
POSTGRES_PROVISIONING_URL=postgresql://myproject_app:REPLACE_ME@postgres:5432/postgres

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REPLACE_ME - generate with: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_ME

# ------------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# REPLACE_ME - 256-bit hex key, EXACTLY 64 characters. Generate with:
#   openssl rand -hex 32
# Losing/rotating this key makes every encrypted secret already in the database
# (platform provisioning passwords, etc.) permanently undecryptable - back it up
# somewhere safe outside of git.
ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# JWT & REFRESH TOKENS
# ------------------------------------------------------------------------------
# REPLACE_ME - at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_ME
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ------------------------------------------------------------------------------
# OTP & TOTP AUTHENTICATION
# ------------------------------------------------------------------------------
OTP_EXPIRES_IN_MINUTES=10
INVITATION_MAX_ATTEMPTS=5
INVITATION_EXPIRES_IN_HOURS=48

# ------------------------------------------------------------------------------
# CLEANUP & RETENTION
# ------------------------------------------------------------------------------
OTP_CLEANUP_RETENTION_DAYS=7
REFRESH_TOKEN_CLEANUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# SMTP - required even locally, since invitations/OTP emails go through it.
# A free option for local/internal use: https://ethereal.email (fake inbox, view
# sent mail in a browser) or your own real SMTP provider if you want real delivery.
# ------------------------------------------------------------------------------
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM="MyProject <no-reply@example.com>"

# ------------------------------------------------------------------------------
# LOGIN BRUTE-FORCE PROTECTION
# ------------------------------------------------------------------------------
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# PROJECT GENERATION ENGINE
# ------------------------------------------------------------------------------
GENERATED_PROJECTS_ROOT=/data/myproject-generated
# Must be an ABSOLUTE path that exists on the HOST machine - docker-compose.local.yml
# bind-mounts it into the container at the exact same path on both sides (required
# for the generator's Docker-in-Docker step to work). Create it first:
#   mkdir -p /data/myproject-generated   (Linux/Mac)
#   mkdir C:\myproject-generated         (Windows - then use that path on both lines)
GENERATED_PROJECTS_HOST_PATH=/data/myproject-generated
GENERATION_COMMAND_TIMEOUT_MS=300000
GENERATION_PORT_RANGE_START=4100
GENERATION_PORT_RANGE_END=4999

# ------------------------------------------------------------------------------
# GENERATED BACKEND GATEWAY
# ------------------------------------------------------------------------------
GENERATED_BACKEND_HOST=127.0.0.1
GENERATED_BACKEND_GATEWAY_PREFIX=/generated

# ------------------------------------------------------------------------------
# GENERATED BACKEND DOCKER ISOLATION
# ------------------------------------------------------------------------------
GENERATED_BACKEND_MEMORY_LIMIT=256m
GENERATED_BACKEND_CPU_LIMIT=0.5
# docker-compose.local.yml overrides GENERATED_BACKEND_DOCKER_NETWORK and
# GENERATED_BACKEND_DB_CONTAINER_NAME directly (derived from PROJECT_NAME above) -
# the values here are only a fallback if you ever run the app outside that compose
# file (e.g. via `pnpm start:prod` directly against this same .env.local).
GENERATED_BACKEND_DOCKER_NETWORK=myproject-local-gen-net
GENERATED_BACKEND_DB_CONTAINER_NAME=myproject-local-postgres
GENERATED_BACKEND_DOCKER_DB_HOST=postgres

# ------------------------------------------------------------------------------
# DATABASE BACKUPS
# ------------------------------------------------------------------------------
BACKUP_OUTPUT_DIR=backups
BACKUP_TIMEOUT_MS=600000
BACKUP_DUMP_RETENTION_HOURS=48

# ------------------------------------------------------------------------------
# SEED / SYSTEM OWNER IDENTITY
# First-boot values only - used once to create the initial owner account. The
# activation link + OTP code are printed to the container logs on first start
# (`./scripts/stack.sh logs local`), never sent anywhere automatically.
# ------------------------------------------------------------------------------
OWNER_WORKEMAIL=REPLACE_ME@example.com
OWNER_PERSONALEMAIL=REPLACE_ME@example.com
OWNER_FIRSTNAME=REPLACE_ME
OWNER_LASTNAME=REPLACE_ME
OWNER_USERNAME=REPLACE_ME

# ------------------------------------------------------------------------------
# DOCKER IMAGE TAG (docker-compose.local.yml only)
# ------------------------------------------------------------------------------
IMAGE_TAG=latest
